* {
    bg0:     #111111;   /* bg_dark */
    bg1:     #232236;   /* bg */
    bg2:     #302f4d;   /* bg_highlight */
    bg3:     #5b547e;   /* dark3 */
    fg0:     #d3c8f5;   /* fg */
    fg1:     #8f82b8;   /* fg_dark */
    fg2:     #7b73a2;   /* dark5 */
    red:     #ff757f;
    green:   #c3e88d;
    yellow:  #ffc777;
    blue:    #82aaff;
    magenta: #c099ff;
    cyan:    #86e1fc;
    purple:  #fca7ea;

    accent:  @magenta;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}
