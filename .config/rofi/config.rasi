listbox {
    padding:          12px;
    spacing:          0;
    background-color: transparent;
    children:         [ listview ];
}

/* ── Main box ─────────────────────────────────────────────────────────── */
mainbox {
    background-color: transparent;
    children:         [ inputbar, message, listview ];
    spacing:          0;
    padding:          12px;
}

/* ── Input bar ────────────────────────────────────────────────────────── */
inputbar {
    background-color: @bg0;
    padding:          1px 10px;
    margin:           0 0 10px 0;
    children:         [ prompt, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @accent;
    font:             "Iosevka Nerd Font 20";
}

entry {
    background-color: transparent;
    text-color:       @fg0;
    placeholder:      "";
    placeholder-color: @fg2;
    font:             "Iosevka Nerd Font 20";
    cursor:           text;
}



button {
    background-color: @bg2;
    text-color:       @fg0;
    border-radius:    1px;
    cursor:           pointer;
}

button selected {
    background-color: @accent;
    text-color:       @bg0;
}

/* ── List view ────────────────────────────────────────────────────────── */
listview {
    background-color: transparent;
    columns:          1;
    lines:            5;
    spacing:          4px;
    fixed-height:     false;
}

scrollbar {
    width:            4px;
    handle-width:     4px;
    background-color: @bg2;
    handle-color:     @accent;
    border-radius:    0px;
}

/* ── List elements ────────────────────────────────────────────────────── */
element {
    background-color: transparent;
    text-color:       @fg0;
    border-radius:    0px;
    padding:          8px 10px;
    spacing:          8px;
    orientation:      horizontal;
    cursor:           pointer;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg0;
}

element normal.urgent {
    background-color: transparent;
    text-color:       @urgent;
}

element normal.active {
    background-color: transparent;
    text-color:       @cyan;
}

element selected.normal {
    background-color: @fg1;
    text-color:       @bg0;
    border-color:     @accent;
}

element selected.urgent {
    background-color: @bg3;
    text-color:       @urgent;
    border-color:     @urgent;
}

element selected.active {
    background-color: @bg3;
    text-color:       @cyan;
    border-color:     @cyan;
}

element-icon {
    background-color: transparent;
    size:             24px;
    cursor:           inherit;
}

element-text {
    background-color: transparent;
    text-color:       inherit;
    cursor:           inherit;
    vertical-align:   0.5;
    font:             "Iosevka Nerd Font 20";
}

/* ── Message ──────────────────────────────────────────────────────────── */
message {
    background-color: @bg2;
    border-radius:    0px;
    padding:          8px 12px;
    margin:           0 0 10px 0;
}

textbox {
    background-color: transparent;
    text-color:       @fg2;
    font:             "Iosevka Nerd Font 20";
}
