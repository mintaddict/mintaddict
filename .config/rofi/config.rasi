configuration {
    modes:              "drun";
    sorting-method:     "normal";
    show-icons:         true;
    terminal:           "kitty";
    editor:             "micro";
    matching:           "regex";
    drun-match-fields:  "name";
    /*display-run:        "Window:";
    display-ssh:        " SSH:";
    display-drun:       "󰀻 Apps:";
        display-emoji:		"󱃞 Emoji";
        */
     kb-move-char-forward: "Right";
    kb-move-char-back: "Left";
    kb-mode-next: "Alt+Right";
    window-format: "{n} {t}";
    kb-mode-previous: "Alt+Left";
    drun-display-format: "{name}";
    fixed-height: true;
   }


@theme "storm"

/* ── Palette ──────────────────────────────────────────────────────────── */
* {
    bg0:     #141319;   /* bg_dark */
    bg1:     #232236;   /* bg */
    bg2:     #302f4d;   /* bg_highlight */
    bg3:     #5b547e;   /* dark3 */
    fg0:     #d3c8f5;   /* fg */
    fg1:     #8f82b8;   /* fg_dark */
    fg2:     #7b73a2;   /* dark5 */
    red:     #ff757f;
    green:   #c3e88d;
    yellow:  #ffc777;
    blue:    #82aaff;
    magenta: #c099ff;
    cyan:    #86e1fc;
    purple:  #fca7ea;

    accent:  @blue;
    urgent:  @yellow;

    background-color: transparent;
    text-color:       @fg0;
}

/* ── Window ───────────────────────────────────────────────────────────── */
window {
    width:            500px;
    background-color: @bg0;
    border:           1px;
    border-color:     @fg2;
    border-radius:    0px;
    padding:          0;
}

