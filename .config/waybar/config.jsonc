{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 8, // Gaps between modules (4px)

    "modules-left": [
        "niri/workspaces",
        "niri/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "cpu",
        "memory",
        "network",
        "pulseaudio",
        "tray"
    ],

    "tray": {
        "spacing": 10,
        "icon-size": 28,
        "reverse-direction": true,
        "orders": {
            "fcitx": 1,
            "discord": 2,
            "steam": 3,
            "obs": 4
        }
    },

    "niri/window": {
        "format": "<span color='#cccccc'>{title}</span>",
        "max-length": 60,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%Y-%m-%d <span color='#cccccc'>%H:%M:%S</span>}",
        //"tooltip-format": "<tt>{calendar}</tt>",
        "tooltip-format": "<tt><span font='GoMono Nerd Font' size='20pt'><b>{calendar}</b></span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            //"weeks-pos": "right",
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#6e56af'><b>{}</b></span>",
                "days": "<span color='#cccccc'>{}</span>",
                "weeks": "<span color='#f38ba8'>W{}</span>",
                "weekdays": "<span color='#ba5151'><b>{}</b></span>",
                "today": "<span color='#dda646'><b><u>{}</u></b></span>"
            }
        },
        "interval": 1
    },

    "cpu": {
        "interval": 5,
        "format": "CPU <span color='#cccccc'>{usage}%</span>",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "kitty -e btop"
    },

    "memory": {
        "interval": 5,
        "format": "MEM <span color='#cccccc'>{percentage}%</span>",
        "states": { "warning": 70, "critical": 90 },
        "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
        "on-click": "kitty -e btop"
    },

    "backlight": {
        "format": "BRT <span color='#cccccc'>{percent}%</span>",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "BAT <span color='#cccccc'>{capacity}%</span>",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "AC {capacity}%",
        "tooltip-format": "{timeTo} · {power}W"
    },

    "network": {
        "format-ethernet": "NET",
        "format-wifi": "NET <span color='#cccccc'>{signalStrength}%</span>",
        "format-disconnected": "NET --",
        "tooltip-format": "Network Information\n\nSSID: {essid}\nIP: {ipaddr}\nBand: {frequency} MHz\nSignal: {signalStrength}%   \nvia: {ifname}",
        "tooltip-format-disconnected": "no connection"
  },

    "pulseaudio": {
        "format": "VOL <span color='#cccccc'>{volume}%</span>",
        "format-muted": "MUTE",
        "scroll-step": 5,
        "tooltip-format": "{desc}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    },
}
