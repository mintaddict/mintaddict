{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
    	"source": "arch_small", // replace with your specific distro or use 'fastfetch --list-logos' to find the exact logo you want
        "type": "auto",
        "height": 7,
        "padding": {
            "top": 0,
            "left": 0,
        }
    },
    "display": {
        "separator": ""
    },
    "modules": [
        {
            "type": "host",
            "key": "host    ",
            "keyColor": "35",
            "format": "{2}"
        },
        {
            "key": "os      ",
            "keyColor": "38;5;5",
            "type": "os",
            "format": "{3}"
        },
        {
            "key": "kernel  ",
            "keyColor": "38;5;5",
            "type": "kernel",
            "format": "{2}"
        },
        {
            "key": "pkgs    ",
            "keyColor": "38;5;5",
            "type": "packages",
        },
        {
            "key": "system  ",
            "keyColor": "38;5;5",
            "type": "disk",
            "folders": ["/"],
            "format": "{1} / {2} ({3})"
        },
        {
            "key": "uptime  ",
            "keyColor": "38;5;5",
            "type": "uptime" 
        },
        {
            "type": "command",
            "key": "age     ",
            "keyColor": "35",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
    ]
}
