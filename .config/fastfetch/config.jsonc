{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/1.txt",
        "type": "auto",
        "height": 7,
        "padding": {
            "top": 0,
            "left": 0,
        }
    },
    "display": {
        "separator": ""
    },
    "modules": [
        {
            "key": "USER   ",
            "keyColor": "38;5;5",
            "type": "title",
            "format": "{1}"
        },
        {
            "key": "OS     ",
            "keyColor": "38;5;5",
            "type": "os",
            "format": "{3}"
        },
        {
            "key": "KERNEL ",
            "keyColor": "38;5;5",
            "type": "kernel",
            "format": "{2}"
        },
        {
            "key": "AGE    ",
            "keyColor": "38;5;5",
            "type": "command",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "key": "PKGS   ",
            "keyColor": "38;5;5",
            "type": "packages",
            "format": "{11}"
        },
        {
            "key": "SHELL  ",
            "keyColor": "38;5;5",
            "type": "shell",
            "format": "{1}"
        },
        {
            "key": "WM     ",
            "keyColor": "38;5;5",
            "type": "wm",
            "format": "{1}"
        },
    ]
}
