export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="gentoo"
plugins=(git zsh-autosuggestions zsh-syntax-highlighting)
source $ZSH/oh-my-zsh.sh
PROMPT='%F{magenta}%~%f %F{white}$%f '
alias kc="kwrite ~/.config/kitty/kitty.conf & disown"
alias zc="kwrite ~/.zshrc & disown"
alias wbc="kwrite ~/.config/waybar/config.jsonc & disown"
alias wbs="kwrite ~/.config/waybar/style.css & disown"
alias rw="pkill waybar && waybar & disown"
alias cache="du -sh ~/.cache/* 2>/dev/null | sort -h"
alias i="sudo emerge --ask"
alias u="sudo emerge --ask --unmerge"
alias c="sudo emerge --ask --depclean"
alias s="sudo emerge --sync"
alias eq="equery l"
alias upd8k="sudo emerge -1av sys-kernel/gentoo-kernel"
alias upd8w="sudo emerge -avuDN @world"
alias upd8g="sudo grub-mkconfig -o /boot/grub/grub.cfg"
alias ck="sudo emerge --ask --prune sys-kernel/gentoo-kernel"
alias uf="cd /etc/portage/package.use"
alias ak="cd /etc/portage/package.accept_keywords/"
alias sn="sudo nano"
alias rb="sudo reboot"
alias po="sudo poweroff"
fastfetch -c '~/.config/fastfetch/config.jsonc'
